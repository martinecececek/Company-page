---
import SectionRibbonBackground from './SectionRibbonBackground.astro';
---

<section class="relative min-h-[calc(92vh-40px)] lg:min-h-[calc(100vh-40px)] flex items-center overflow-hidden">
  <SectionRibbonBackground variant="hero" />
  <div class="relative z-10 max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center py-20">
    <div class="z-10">

      <h1 class="hero-animate-1 text-5xl md:text-7xl font-black leading-[1.1] mb-6 tracking-tight">
        Nabízíme
        <span class="text-primary">weby na míru</span>
        pro reálný růst
      </h1>

      <p class="hero-animate-2 text-lg md:text-xl text-slate-600 dark:text-slate-400 mb-10 leading-relaxed max-w-xl">
        Rychlé weby a online řešení. Více poptávek a lepší výkon vaší společnosti
      </p>
      <p class="sr-only">tvorba webových stránek, webové stránky, web stránka</p>

      <div class="hero-animate-3 flex flex-col sm:flex-row gap-4">
        <a href="/configurator" class="inline-flex items-center justify-center bg-primary text-white text-lg font-bold px-8 py-4 rounded-xl hover:shadow-xl hover:shadow-primary/30 transition-all">
          Spustit konfigurátor
        </a>
      </div>

      <div class="hero-animate-4 mt-12 flex items-center gap-6">
        <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary/10 border border-primary/20 text-primary">
          <span class="material-symbols-outlined text-[20px]" aria-hidden="true">schedule</span>
        </div>
        <div class="text-sm font-medium text-slate-500">
          Odpovíme do 24 hodin
        </div>
      </div>
    </div>

    <div class="hero-animate-img relative group">
      <div class="absolute inset-0 bg-primary/20 blur-[100px] rounded-full scale-95 opacity-50 group-hover:opacity-70 transition-opacity"></div>
      <div class="relative bg-white dark:bg-slate-800 p-4 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700">
        <img
          alt="Náhled webu"
          class="rounded-xl w-full"
          src="/src/assets/image/original-89752515991ed4a50785ac95b85da4a8.webp"
        />
      </div>
    </div>
  </div>
</section>
