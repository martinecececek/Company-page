<section class="py-32 bg-slate-900 text-white" id="success">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-end gap-6 mb-20">
      <div class="max-w-2xl">
        <h2 data-reveal class="text-primary font-bold tracking-widest uppercase text-sm mb-4">Příběhy našich klientů</h2>
        <h3 data-reveal data-reveal-delay="100" class="text-4xl md:text-5xl font-black tracking-tight">
          Reálné výsledky pro firmy, které chtějí růst.
        </h3>
      </div>
      <a data-reveal data-reveal-delay="200" href="/portfolio" class="flex items-center gap-2 font-bold px-6 py-3 border border-slate-700 rounded-lg hover:bg-slate-800 transition-all">
        Zobrazit všechny reference
        <span class="material-symbols-outlined">north_east</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

      <a data-reveal href="/portfolio" class="block bg-slate-800/50 rounded-3xl overflow-hidden border border-slate-700 group hover:border-primary/50 transition-all">
        <div class="aspect-video relative overflow-hidden">
          <img
            alt="Webový projekt"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuDEIMtVzNCjt2pkey98klI2jh_aDkS0WkyK_cCFTX8CSPHIOaGtpdlyHhLPQQ7ATXU4TYeqBbiuzplQtOh2r5Tslu0yyO_F3aNAiwQ6NvI7BA1SoznjDe_dLpVtxKdLcC6fMcZT_HiR4dOmGwGhmXV6e6bmq5uqhpFt34xWbmrfqzfH8uCE3kU8N-Gqdoh5FiBh75oJCUynNa3Y9widhsiuQEO-9z7tzdfspYkY7_1DN03oFgb9NVcFn29nEp9hC26g1rK-Zxmoujta"
          />
