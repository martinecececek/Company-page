---
import SectionRibbonBackground from './SectionRibbonBackground.astro';
---

<section class="relative py-32 overflow-hidden" id="why-us">
  <SectionRibbonBackground variant="why" />
  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">

      <div class="order-2 lg:order-1 relative" data-reveal="left">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl">
          <img
            alt="Porada týmu"
            class="w-full h-full object-cover"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuD8P8AxCZgLBQRIdkvIk0HAYlvEu2lNTCgRNCBDjxICkFBOh3U-AUlQK0LOCoHl67_uk0aDiqm3P-HraDiRowde8QkeUjrH3ZNYZNsWDCdIW5BCov7GkK9pypELiK8iEWoXGJMzwY-Tx6yBP292l_gmQ9RJqG1t5VP9gjLTRa7dNqHjwn1VXm2bzpbNvr0J7gk_F7Dbt5hFh6HpPuJEk2uIb-sMXJYDHvaCWC6G1XcfsHp4y5SM0huLweCIbP8U7QPRdXkoArGp4PZ_"
          />
        </div>
        <div class="absolute -bottom-10 -right-10 bg-primary text-white p-10 rounded-3xl hidden md:block">
          <div class="text-4xl font-black mb-1">
            <span class="counter-value" data-counter-target="99.9" data-counter-suffix="%">99.9%</span>
          </div>
          <div class="text-sm font-bold opacity-80 uppercase tracking-widest">Dostupnost systému</div>
        </div>
      </div>

      <div class="order-1 lg:order-2">
        <p class="text-primary font-bold tracking-widest uppercase text-sm mb-4" data-reveal="up">Proč právě my</p>
        <h2 class="text-4xl md:text-5xl font-black tracking-tight mb-8" data-reveal="up" data-delay="100">
          Rychlost, kvalita a jasný postup od začátku do konce.
        </h2>

        <div class="space-y-8">
          <div class="flex gap-6" data-reveal="up" data-delay="200">
            <div class="size-12 rounded-full bg-primary/10 flex-shrink-0 flex items-center justify-center text-primary">
              <span class="material-symbols-outlined">bolt</span>
            </div>
            <div>
              <h5 class="text-xl font-bold mb-2">2× rychlejší spuštění</h5>
              <p class="text-slate-500 dark:text-slate-400">
                Díky ověřenému procesu spouštíme projekty výrazně rychleji než běžný standard.
              </p>
            </div>
          </div>

          <div class="flex gap-6" data-reveal="up" data-delay="300">
            <div class="size-12 rounded-full bg-primary/10 flex-shrink-0 flex items-center justify-center text-primary">
              <span class="material-symbols-outlined">shield</span>
            </div>
            <div>
              <h5 class="text-xl font-bold mb-2">Kvalita na profesionální úrovni</h5>
              <p class="text-slate-500 dark:text-slate-400">
                Váš web pečlivě kontrolujeme, aby byl bezpečný a spolehlivý.
              </p>
            </div>
          </div>

          <div class="flex gap-6" data-reveal="up" data-delay="400">
            <div class="size-12 rounded-full bg-primary/10 flex-shrink-0 flex items-center justify-center text-primary">
              <span class="material-symbols-outlined">groups</span>
            </div>
            <div>
              <h5 class="text-xl font-bold mb-2">Uživatel na prvním místě</h5>
              <p class="text-slate-500 dark:text-slate-400">
                Navrhujeme rozhraní tak, aby se v něm lidé rychle zorientovali a rádi ho používali.
              </p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Animate the 99.9% counter when the element enters the viewport
  (function () {
    const counterEl = document.querySelector<HTMLElement>('.counter-value[data-counter-target]');
    if (!counterEl) return;

    const target = parseFloat(counterEl.dataset.counterTarget ?? '0');
    const suffix = counterEl.dataset.counterSuffix ?? '';

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();

        const duration = 1400;
        const start = performance.now();

        function tick(now: number) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          // ease-out cubic
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = eased * target;
          counterEl!.textContent = current.toFixed(1) + suffix;
          if (progress < 1) requestAnimationFrame(tick);
        }

        requestAnimationFrame(tick);
      });
    }, { threshold: 0.5 });

    observer.observe(counterEl);
  })();
</script>
