---
import SectionRibbonBackground from './SectionRibbonBackground.astro';
---

<section class="relative py-32 overflow-hidden" id="services">
  <SectionRibbonBackground variant="expertise" />
  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <div class="max-w-3xl mb-20">
      <p class="text-primary font-bold tracking-widest uppercase text-sm mb-4">Naše specializace</p>
      <h2 class="text-4xl md:text-5xl font-black tracking-tight mb-6">
        Praktické digitální služby pro růst vašeho podnikání.
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

      <div class="group bg-white dark:bg-slate-800 p-8 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-primary transition-all hover:shadow-xl">
        <div class="size-14 bg-primary/10 text-primary rounded-xl flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-all">
          <span class="material-symbols-outlined text-3xl">code</span>
        </div>
        <h4 class="text-xl font-bold mb-3">Vývoj webu</h4>
        <p class="text-slate-500 dark:text-slate-400 leading-relaxed mb-6">
          Rychlé, bezpečné a spolehlivé weby pro každodenní provoz.
        </p>
        <a class="text-primary font-bold flex items-center gap-1 group/link" href="/services">
          Zjistit více
          <span class="material-symbols-outlined text-sm group-hover/link:translate-x-1 transition-transform">arrow_forward</span>
        </a>
      </div>

      <div class="group bg-white dark:bg-slate-800 p-8 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-primary transition-all hover:shadow-xl">
        <div class="size-14 bg-primary/10 text-primary rounded-xl flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-all">
          <span class="material-symbols-outlined text-3xl">draw</span>
        </div>
        <h4 class="text-xl font-bold mb-3">Návrh vzhledu a ovládání</h4>
        <p class="text-slate-500 dark:text-slate-400 leading-relaxed mb-6">
          Přehledné stránky, ve kterých se lidé snadno orientují.
        </p>
        <a class="text-primary font-bold flex items-center gap-1 group/link" href="/services">
          Zjistit více
          <span class="material-symbols-outlined text-sm group-hover/link:translate-x-1 transition-transform">arrow_forward</span>
        </a>
      </div>

      <div class="group bg-white dark:bg-slate-800 p-8 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-primary transition-all hover:shadow-xl">
        <div class="size-14 bg-primary/10 text-primary rounded-xl flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-all">
          <span class="material-symbols-outlined text-3xl">trending_up</span>
        </div>
        <h4 class="text-xl font-bold mb-3">Online propagace</h4>
        <p class="text-slate-500 dark:text-slate-400 leading-relaxed mb-6">
          Jednoduché kroky, které přivedou více návštěvníků i poptávek.
        </p>
        <a class="text-primary font-bold flex items-center gap-1 group/link" href="/services">
          Zjistit více
          <span class="material-symbols-outlined text-sm group-hover/link:translate-x-1 transition-transform">arrow_forward</span>
        </a>
      </div>

      <div class="group bg-white dark:bg-slate-800 p-8 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-primary transition-all hover:shadow-xl">
        <div class="size-14 bg-primary/10 text-primary rounded-xl flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-all">
          <span class="material-symbols-outlined text-3xl">cloud</span>
        </div>
        <h4 class="text-xl font-bold mb-3">Správa provozu webu</h4>
        <p class="text-slate-500 dark:text-slate-400 leading-relaxed mb-6">
          Stabilní provoz webu, aby byl dostupný a připravený na větší návštěvnost.
        </p>
        <a class="text-primary font-bold flex items-center gap-1 group/link" href="/services">
          Zjistit více
          <span class="material-symbols-outlined text-sm group-hover/link:translate-x-1 transition-transform">arrow_forward</span>
        </a>
      </div>

    </div>
  </div>
</section>
