---
const roadmapHighlights = [
  {
    icon: 'track_changes',
    title: 'Jasné milníky',
    text: '6 přehledných kroků od prvního zadání po dlouhodobou podporu.'
  },
  {
    icon: 'sync',
    title: 'Rychlá zpětná vazba',
    text: 'Pravidelné kontroly drží tempo a odstraňují nejistotu.'
  },
  {
    icon: 'verified',
    title: 'Jisté spuštění',
    text: 'Kontrola kvality, předání a měřitelný růst po spuštění.'
  }
];

const roadmapSteps = [
  {
    number: '01',
    icon: 'chat_bubble',
    title: '1. Dotaz / Zadání',
    description: 'Úvodní fáze. Probereme cíle, cílovou skupinu a směr projektu.',
    outcome: 'Výstup: jasné cíle, priority a další postup.',
    timing: '1. týden'
  },
  {
    number: '02',
    icon: 'biotech',
    title: '2. Analýza & Zadání',
    description: 'Plán projektu. Domluvíme funkce, rozsah a jasné kroky.',
    outcome: 'Výstup: schválený rozsah a plán realizace.',
    timing: '1.–2. týden'
  },
  {
    number: '03',
    icon: 'palette',
    title: '3. Design',
    description: 'Návrh vzhledu. Připravíme stránky tak, aby byly přehledné a srozumitelné.',
    outcome: 'Výstup: potvrzený vizuální směr a uživatelská cesta.',
    timing: '2. týden'
  },
  {
    number: '04',
    icon: 'terminal',
    title: '4. Vývoj',
    description: 'Realizace. Připravíme stabilní řešení, které je rychlé a připravené na růst.',
    outcome: 'Výstup: hotová verze připravená ke spuštění.',
    timing: '3.–4. týden'
  },
  {
    number: '05',
    icon: 'rocket_launch',
    title: '5. Spuštění',
    description: 'Finalizace. Proběhne testování, nasazení a předání týmu.',
    outcome: 'Výstup: stabilní spuštění a kompletní předání.',
    timing: 'od 4. týdne'
  },
  {
    number: '06',
    icon: 'support_agent',
    title: '6. Podpora',
    description: 'Dlouhodobý rozvoj. Průběžná technická podpora a další zlepšování.',
    outcome: 'Výstup: měřitelné zlepšení a pravidelná podpora.',
    timing: 'průběžně'
  }
];
---

<section class="py-32 bg-background-dark text-white overflow-hidden relative section-reveal" id="process">
  <div class="max-w-7xl mx-auto px-6">
    <div class="mb-18 text-center section-heading">
      <span class="bg-primary/20 text-primary border border-primary/30 px-6 py-2 rounded-full text-sm font-black uppercase tracking-widest mb-6 inline-block">
        Jak spolupracujeme
      </span>
      <h2 class="text-5xl md:text-7xl font-black tracking-tighter mb-8 italic uppercase">
        Cesta k výsledku
      </h2>
      <p class="text-slate-300 text-xl max-w-2xl mx-auto font-medium">
        Přehledný proces zaměřený na výsledek — od nápadu až po funkční a výkonný web.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4 max-w-5xl mx-auto mb-20 section-heading">
      {roadmapHighlights.map((item) => (
        <article class="roadmap-reward-card rounded-2xl border border-primary/20 bg-slate-900/70 px-5 py-4 text-left">
          <div class="flex items-center gap-2 mb-2">
            <span class="material-symbols-outlined text-primary">{item.icon}</span>
            <h3 class="font-extrabold text-white text-base">{item.title}</h3>
          </div>
          <p class="text-slate-300 text-sm leading-relaxed">{item.text}</p>
        </article>
      ))}
    </div>

    <div class="relative max-w-6xl mx-auto">
      <div class="roadmap-path-container hidden lg:block">
        <div class="roadmap-path-fill" id="roadmapLine"></div>
      </div>

      <div class="space-y-20 lg:space-y-32 relative">
        {roadmapSteps.map((step, index) => {
          const alignRight = index % 2 === 0;

          return (
            <div class="reveal-step flex flex-col lg:flex-row items-center gap-10 lg:gap-0">
              {alignRight ? (
                <>
                  <div class="lg:w-1/2 lg:pr-24 text-center lg:text-right order-2 lg:order-1">
                    <div class="process-card-neo roadmap-card p-8 md:p-10 rounded-2xl inline-block w-full text-left lg:text-right">
                      <div class="flex flex-col items-center lg:items-end">
                        <div class="step-meta-row justify-center lg:justify-end">
                          <span class="step-meta-pill">Milník {step.number}</span>
                          <span class="step-meta-pill step-meta-pill--ghost">{step.timing}</span>
                        </div>
                        <span class="material-symbols-outlined text-primary text-5xl mb-5">{step.icon}</span>
                        <h4 class="text-3xl md:text-4xl font-black mb-4 leading-none text-white">{step.title}</h4>
                        <p class="text-slate-200 text-base md:text-lg font-medium leading-relaxed max-w-md lg:ml-auto">{step.description}</p>
                        <p class="step-outcome max-w-md lg:ml-auto">{step.outcome}</p>
                      </div>
                    </div>
                  </div>

                  <div class="relative z-20 order-1 lg:order-2">
                    <div class="size-20 rounded-full bg-primary flex items-center justify-center pulse-marker roadmap-marker shadow-[0_0_30px_rgba(19,91,236,0.8)]">
                      <span class="text-white font-black text-2xl">{step.number}</span>
                    </div>
                  </div>

                  <div class="lg:w-1/2 hidden lg:block order-3"></div>
                </>
              ) : (
                <>
                  <div class="lg:w-1/2 hidden lg:block"></div>

                  <div class="relative z-20">
                    <div class="size-20 rounded-full bg-primary flex items-center justify-center pulse-marker roadmap-marker shadow-[0_0_30px_rgba(19,91,236,0.8)]">
                      <span class="text-white font-black text-2xl">{step.number}</span>
                    </div>
                  </div>

                  <div class="lg:w-1/2 lg:pl-24 text-center lg:text-left">
                    <div class="process-card-neo roadmap-card p-8 md:p-10 rounded-2xl inline-block w-full text-left">
                      <div class="flex flex-col items-center lg:items-start">
                        <div class="step-meta-row justify-center lg:justify-start">
                          <span class="step-meta-pill">Milník {step.number}</span>
                          <span class="step-meta-pill step-meta-pill--ghost">{step.timing}</span>
                        </div>
                        <span class="material-symbols-outlined text-primary text-5xl mb-5">{step.icon}</span>
                        <h4 class="text-3xl md:text-4xl font-black mb-4 leading-none text-white">{step.title}</h4>
                        <p class="text-slate-200 text-base md:text-lg font-medium leading-relaxed max-w-md">{step.description}</p>
                        <p class="step-outcome max-w-md">{step.outcome}</p>
                      </div>
                    </div>
                  </div>
                </>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const processSection = document.getElementById('process');
    const steps = document.querySelectorAll('.reveal-step');
    const roadmapLine = document.getElementById('roadmapLine');

    const sectionObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });

    if (processSection) {
      sectionObserver.observe(processSection);
    }

    const observer = new IntersectionObserver((entries, stepObserver) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
          stepObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });

    steps.forEach((step, index) => {
      (step as HTMLElement).style.setProperty('--step-delay', `${index * 120}ms`);
      observer.observe(step);
    });

    window.addEventListener('scroll', () => {
      if (!processSection || !roadmapLine) return;
      const sectionTop = processSection.offsetTop;
      const sectionHeight = processSection.offsetHeight;
      const scrollPos = window.scrollY + window.innerHeight / 1.5;
      if (scrollPos > sectionTop) {
        let progress = ((scrollPos - sectionTop) / (sectionHeight - 300)) * 100;
        progress = Math.min(100, Math.max(0, progress));
        (roadmapLine as HTMLElement).style.height = progress + '%';
      }
    });
  });
</script>

<style>
  .section-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.75s ease, transform 0.75s ease;
  }

  .section-reveal.active {
    opacity: 1;
    transform: translateY(0);
  }

  .section-heading {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.85s ease 120ms, transform 0.85s ease 120ms;
  }

  .roadmap-path-container {
    z-index: 0;
  }

  .section-reveal.active .section-heading {
    opacity: 1;
    transform: translateY(0);
  }

  .reveal-step {
    position: relative;
    z-index: 2;
    opacity: 0;
    transform: translateY(36px) scale(0.98);
    transition: opacity 0.75s ease, transform 0.75s ease;
    transition-delay: var(--step-delay, 0ms);
  }

  .reveal-step.active,
  .roadmap-reward-card {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .reveal-step .roadmap-card {
    opacity: 0;
    transform: translateX(28px);
    transition:
      opacity 0.65s ease,
      transform 0.65s ease,
      filter 0.3s ease;
    transition-delay: calc(var(--step-delay, 0ms) + 120ms);
    position: relative;
    overflow: hidden;
  }

  .reveal-step .roadmap-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 20%, rgba(255, 255, 255, 0.14) 48%, transparent 76%);
    transform: translateX(-130%);
    transition: transform 0.65s ease;
  }

  .reveal-step .roadmap-card:hover::before {
    transform: translateX(130%);
  }

  .reveal-step:nth-of-type(odd) .roadmap-card {
    transform: translateX(-28px);
  }

  .reveal-step.active .roadmap-card {
    opacity: 1;
    transform: translateX(0);
  }

  .reveal-step.active .roadmap-card:hover {
    filter: brightness(1.06);
  }

  .roadmap-reward-card {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .step-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    width: 100%;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .step-meta-pill {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid rgba(96, 165, 250, 0.5);
    background: rgba(19, 91, 236, 0.16);
    color: #bfdbfe;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
  }

  .step-meta-pill--ghost {
    border-color: rgba(148, 163, 184, 0.35);
    background: rgba(15, 23, 42, 0.45);
    color: #cbd5e1;
  }

  .step-outcome {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(148, 163, 184, 0.25);
    color: #bfdbfe;
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .reveal-step .pulse-marker {
    position: relative;
    z-index: 3;
    transform: scale(0.82);
    opacity: 0.75;
    transition: transform 0.5s ease, opacity 0.5s ease;
    transition-delay: calc(var(--step-delay, 0ms) + 80ms);
  }

  .reveal-step .pulse-marker > span {
    position: relative;
    z-index: 4;
  }

  .reveal-step.active .pulse-marker {
    transform: scale(1);
    opacity: 1;
    animation: markerPulse 2.4s ease-in-out infinite;
  }

  .roadmap-marker {
    position: relative;
    isolation: isolate;
    transition: transform 0.35s ease;
  }

  .roadmap-marker::after {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 9999px;
    border: 2px solid rgba(125, 211, 252, 0.5);
    box-shadow: 0 0 0 1px rgba(19, 91, 236, 0.35);
    transform: scale(0.84);
    opacity: 0;
    pointer-events: none;
  }

  .reveal-step:hover .roadmap-marker {
    transform: scale(1.06);
  }

  .reveal-step:hover .roadmap-marker::after {
    opacity: 1;
    animation: markerOrbitRing 1.15s ease-out infinite;
  }

  @keyframes markerPulse {
    0%,
    100% {
      box-shadow: 0 0 24px rgba(19, 91, 236, 0.65);
    }
    50% {
      box-shadow: 0 0 42px rgba(19, 91, 236, 0.95);
    }
  }

  @keyframes markerOrbitRing {
    0% {
      transform: scale(0.84);
      opacity: 0.7;
    }
    60% {
      transform: scale(1.16);
      opacity: 0;
    }
    100% {
      transform: scale(1.16);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-reveal,
    .section-heading,
    .reveal-step,
    .reveal-step .roadmap-card,
    .reveal-step .pulse-marker,
    .roadmap-reward-card {
      transition: none !important;
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }

    .reveal-step .roadmap-card::before {
      display: none;
    }

    .roadmap-marker::after,
    .reveal-step:hover .roadmap-marker::after {
      animation: none !important;
      opacity: 0 !important;
      transform: none !important;
    }
  }
</style>
