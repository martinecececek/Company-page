                      </div>
                      <textarea data-content-text={section.id} class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-2 outline-none focus:border-primary resize-y" rows="3" placeholder={`Text nebo instrukce pro sekci „${section.label}“`}></textarea>
                    </div>
