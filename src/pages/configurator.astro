---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StepPanel from '../components/configurator/StepPanel.astro';
import ToggleButton from '../components/configurator/ToggleButton.astro';
import FeatureCard from '../components/configurator/FeatureCard.astro';

const websiteTypes = [
  { id: 'company', label: 'Firemní web', description: 'Profesionální prezentace firmy a sběr poptávek.' },
  { id: 'landing', label: 'Landing page', description: 'Jednostránková kampaň zaměřená na konverze.' },
  { id: 'portfolio', label: 'Portfolio', description: 'Ukázka projektů, referencí a důvěryhodnosti.' },
  { id: 'blog', label: 'Blog', description: 'Obsahový web pro publikování a lepší viditelnost na Googlu.' },
  { id: 'ecommerce', label: 'E-shop', description: 'Katalog produktů, objednávky a prodejní proces.' },
  { id: 'webapp', label: 'Webová aplikace', description: 'Interaktivní aplikace s uživatelskou logikou a pokročilými funkcemi.' }
];

const pagesCatalog = [
  { id: 'home', label: 'Domů', description: 'Hlavní vstupní stránka' },
  { id: 'about', label: 'O nás', description: 'Důvěra a příběh týmu' },
  { id: 'services', label: 'Služby', description: 'Nabídka a hodnota pro klienta' },
  { id: 'portfolio', label: 'Portfolio', description: 'Případové studie a důkazy výsledků' },
  { id: 'pricing', label: 'Ceník', description: 'Transparentní struktura nabídky' },
  { id: 'blog', label: 'Blog', description: 'Články a obsahový hub' },
  { id: 'faq', label: 'FAQ', description: 'Odpovědi na klíčové otázky' },
  { id: 'contact', label: 'Kontakt', description: 'Předání poptávky a komunikace' },
  { id: 'shop', label: 'Obchod', description: 'Výpis produktů' },
  { id: 'checkout', label: 'Košík a objednávka', description: 'Dokončení objednávky' },
  { id: 'dashboard', label: 'Uživatelská zóna', description: 'Přehled uživatelského účtu' }
];

const featuresCatalog = [
  { id: 'contact-form', title: 'Kontaktní formuláře', icon: 'mail', description: 'Sbírejte poptávky pomocí přehledných formulářů.' },
  { id: 'analytics', title: 'Analytika', icon: 'analytics', description: 'Sledujte návštěvnost a chování uživatelů v přehledných reportech.' },
  { id: 'seo', title: 'Nastavení viditelnosti ve vyhledávání', icon: 'travel_explore', description: 'Nastavíme strukturu webu tak, aby vás lidé našli na Googlu a dalších vyhledávačích.' },
  { id: 'newsletter', title: 'Newsletter', icon: 'campaign', description: 'Budujte publikum a návratnost pomocí e-mailových kampaní.' },
  { id: 'auth', title: 'Přihlášení uživatelů', icon: 'verified_user', description: 'Bezpečné přihlášení a přístup k uživatelskému účtu.' },
  { id: 'admin-panel', title: 'Administrace', icon: 'admin_panel_settings', description: 'Interní správa uživatelů, obsahu a nastavení.' },
  { id: 'payments', title: 'Platby', icon: 'credit_card', description: 'Online platební proces a zpracování transakcí.' },
  { id: 'order-system', title: 'Objednávkový systém', icon: 'receipt_long', description: 'Zpracování objednávek, stavy a návazná logika.' },
  { id: 'dynamic-cms-db', title: 'Dynamické CMS + DB', icon: 'edit_note', description: 'Správa obsahu napojená na databázi.' }
];

const fontPairs = [
  {
    id: 'inter-space',
    label: 'Inter + Space Grotesk',
    heading: "'Space Grotesk', Inter, sans-serif",
    body: 'Inter, sans-serif',
    preview: 'Moderní a čistý styl s jasnou hierarchií.'
  },
  {
    id: 'manrope-inter',
    label: 'Manrope + Inter',
    heading: 'Manrope, Inter, sans-serif',
    body: 'Inter, sans-serif',
    preview: 'Neutrální, čitelný a konverzně orientovaný styl.'
  },
  {
    id: 'playfair-inter',
    label: 'Playfair + Inter',
    heading: "'Playfair Display', Georgia, serif",
    body: 'Inter, sans-serif',
    preview: 'Prémiový redakční vzhled značky.'
  },
  {
    id: 'poppins-roboto',
    label: 'Poppins + Roboto',
    heading: 'Poppins, Inter, sans-serif',
    body: 'Roboto, Inter, sans-serif',
    preview: 'Přátelský a velmi čitelný vizuální styl.'
  },
  {
    id: 'montserrat-source',
    label: 'Montserrat + Source Sans',
    heading: 'Montserrat, Inter, sans-serif',
    body: "'Source Sans 3', Inter, sans-serif",
    preview: 'Strukturovaný firemní vzhled s důrazem na přehlednost.'
  }
];

const contentSections = pagesCatalog.map((page) => ({
  id: page.id,
  label: page.id === 'home' ? 'Domů / Hero' : page.id === 'contact' ? 'Kontakt / CTA' : page.label
}));

const assetSlots = [
  { id: 'hero', label: 'Hero obrázek', hint: 'Doporučeno: 1920×1080', relatedPages: ['home'] },
  { id: 'about', label: 'O nás obrázek', hint: 'Doporučeno: 1600×900', relatedPages: ['about'] },
  { id: 'services', label: 'Služby / ikony', hint: 'Doporučeno: 1200×1200', relatedPages: ['services', 'shop'] },
  { id: 'team', label: 'Týmové fotografie', hint: 'Doporučeno: 1200×1600', relatedPages: ['about'] },
  { id: 'logos', label: 'Loga značky', hint: 'SVG/PNG v transparentním pozadí', relatedPages: [] },
  { id: 'gallery', label: 'Galerie / reference', hint: 'Více snímků projektu', relatedPages: ['portfolio', 'shop'] }
];

const presets = {
  company: {
    hosting: 'static',
    pages: {
      required: ['home', 'contact'],
      recommended: ['about', 'services', 'faq', 'pricing', 'portfolio'],
      default: []
    },
    features: {
      required: [],
      recommended: ['contact-form', 'analytics', 'seo'],
      default: []
    }
  },
  landing: {
    hosting: 'static',
    pages: {
      required: ['home'],
      recommended: ['contact'],
      default: []
    },
    features: {
      required: [],
      recommended: ['contact-form', 'analytics', 'seo'],
      default: []
    }
  },
  portfolio: {
    hosting: 'static',
    pages: {
      required: ['home', 'portfolio', 'contact'],
      recommended: ['about'],
      default: []
    },
    features: {
      required: [],
      recommended: ['contact-form', 'analytics', 'seo'],
      default: []
    }
  },
  blog: {
    hosting: 'static',
    pages: {
      required: ['home', 'blog'],
      recommended: ['about', 'contact'],
      default: []
    },
    features: {
      required: ['dynamic-cms-db'],
      recommended: ['newsletter', 'analytics', 'seo'],
      default: []
    }
  },
  ecommerce: {
    hosting: 'fullstack',
    pages: {
      required: ['shop', 'checkout'],
      recommended: ['home', 'faq', 'dashboard'],
      default: []
    },
    features: {
      required: ['order-system', 'payments', 'admin-panel', 'dynamic-cms-db'],
      recommended: ['auth', 'contact-form', 'analytics', 'seo', 'newsletter'],
      default: []
    }
  },
  webapp: {
    hosting: 'fullstack',
    pages: {
      required: ['dashboard', 'home'],
      recommended: ['contact', 'faq'],
      default: []
    },
    features: {
      required: ['admin-panel', 'auth', 'dynamic-cms-db'],
      recommended: ['contact-form', 'analytics', 'seo', 'newsletter'],
      default: []
    }
  }
};

const hostingTriggerFeatures = ['auth', 'admin-panel', 'payments', 'order-system', 'dynamic-cms-db'];

const initialType = 'company';
const initialPreset = presets[initialType];
const initialPages = [...initialPreset.pages.required, ...initialPreset.pages.recommended, ...initialPreset.pages.default];
const nonPreselectedRecommendedFeatureKeys = new Set(['analytics']);
const initialRecommendedFeatures = [...initialPreset.features.recommended].filter((featureId) => !nonPreselectedRecommendedFeatureKeys.has(featureId));
const initialFeatures = [...initialPreset.features.required, ...initialRecommendedFeatures, ...initialPreset.features.default];
---

<Layout title="Webový konfigurátor | NexusDigital">
  <Header />

  <main class="relative overflow-hidden pt-28 pb-20 min-h-screen bg-background-light dark:bg-background-dark px-4 md:px-6">
    <div class="absolute -top-20 -left-20 w-72 h-72 rounded-full bg-primary/10 blur-3xl pointer-events-none"></div>
    <div class="absolute top-40 -right-20 w-80 h-80 rounded-full bg-primary/10 blur-3xl pointer-events-none"></div>

    <section class="max-w-6xl mx-auto relative z-10">
      <div class="max-w-3xl mb-8">
        <p class="text-primary text-xs font-black tracking-[0.14em] uppercase mb-3">Webový konfigurátor</p>
        <h1 class="text-4xl md:text-5xl font-black tracking-tight text-slate-900 dark:text-white leading-tight mb-4">Naplánujte projekt pomocí chytrého 6krokového konfigurátoru</h1>
        <p class="text-slate-600 dark:text-slate-400 text-lg">Chytré presety, interaktivní ovládání, živý náhled designu a finální souhrn v jednom toku.</p>
      </div>

      <form id="configuratorForm" action="/api/configurator-submit" method="post" class="space-y-4">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 md:p-6">
          <div class="flex items-center justify-between gap-4 flex-wrap mb-3">
            <p id="stepCounter" class="text-sm font-bold uppercase tracking-wider text-primary" aria-live="polite">Krok 1 / 6</p>
            <p id="stepTitle" class="text-sm font-semibold text-slate-500 dark:text-slate-400">Typ webu</p>
          </div>
          <div
            id="stepProgressBar"
            class="h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden"
            role="progressbar"
            aria-valuemin="1"
            aria-valuemax="6"
            aria-valuenow="1"
            aria-valuetext="Krok 1 z 6"
          >
            <div id="stepProgress" class="h-full bg-primary transition-all duration-300" style="width: 16.66%"></div>
          </div>
        </div>

        <StepPanel step={1} title="Typ webu" subtitle="Vyberte typ projektu a nechte presety automaticky nastavit stránky, funkce i hosting." active={true}>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
            {websiteTypes.map((item, index) => (
              <button
                type="button"
                data-website-type
                data-id={item.id}
                class:list={{ 'cfg-type-btn': true, 'is-active': index === 0 }}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <p class="font-extrabold text-slate-900 dark:text-white text-base mb-1">{item.label}</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">{item.description}</p>
              </button>
            ))}
          </div>

          <div class="mt-5 inline-flex items-center gap-2 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2">
            <span class="material-symbols-outlined text-primary text-base">deployed_code</span>
            <p id="hostingIndicator" class="text-sm font-semibold text-slate-700 dark:text-slate-300">Hosting: Statický</p>
          </div>
        </StepPanel>

        <StepPanel step={2} title="Obsah webu" subtitle="Přepínače obsahu webu s doporučenými presety.">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
            {pagesCatalog.map((page) => (
              <ToggleButton kind="page" id={page.id} label={page.label} description={page.description} />
            ))}
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-4">Legenda: Doporučené ⭐</p>
        </StepPanel>

        <StepPanel step={3} title="Funkce" subtitle="Karty funkcí se stavovými štítky a kontextovým vysvětlením.">
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
            {featuresCatalog.map((feature) => (
              <FeatureCard id={feature.id} title={feature.title} icon={feature.icon} description={feature.description} />
            ))}
          </div>
        </StepPanel>

        <StepPanel step={4} title="Design studio" subtitle="Šablona + párování fontů + barevné téma se živým náhledem.">
          <div class="grid grid-cols-1 xl:grid-cols-[1.1fr_0.9fr] gap-5 items-start">
            <div class="space-y-5">
              <div>
                <p class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-3">Preset šablony</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  {[
                    { id: 'modern', label: 'Moderní' },
                    { id: 'minimal', label: 'Minimalistický' },
                    { id: 'bold', label: 'Výrazný' },
                    { id: 'elegant', label: 'Elegantní' },
                    { id: 'custom', label: 'Vlastní' }
                  ].map((preset, index) => (
                    <button type="button" data-template={preset.id} class:list={{ 'cfg-toggle-btn': true, 'is-selected': index === 0 }}>
                      <div class="flex items-center justify-between gap-3">
                        <span class="font-extrabold text-slate-900 dark:text-white">{preset.label}</span>
                        <span class="cfg-state-badge">Styl</span>
                      </div>
                    </button>
                  ))}
                </div>
              </div>

              <div>
                <p class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-3">Párování fontů</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  {fontPairs.map((pair, index) => (
                    <button type="button" data-font-pair={pair.id} data-heading-font={pair.heading} data-body-font={pair.body} class:list={{ 'cfg-toggle-btn': true, 'is-selected': index === 0 }}>
                      <p class="font-extrabold text-slate-900 dark:text-white mb-1">{pair.label}</p>
                      <p class="text-xs text-slate-500 dark:text-slate-400">{pair.preview}</p>
                    </button>
                  ))}
                </div>
              </div>

              <div>
                <p class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-3">Barevné studio</p>
                <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
                  <label class="cfg-color-input">Primární<input data-color="primary" type="color" value="#135bec" /></label>
                  <label class="cfg-color-input">Sekundární<input data-color="secondary" type="color" value="#0f172a" /></label>
                  <label class="cfg-color-input">Akcent<input data-color="accent" type="color" value="#22c55e" /></label>
                  <label class="cfg-color-input">Pozadí<input data-color="background" type="color" value="#ffffff" /></label>
                  <label class="cfg-color-input">Text<input data-color="text" type="color" value="#0f172a" /></label>
                </div>
              </div>

              <div>
                <p class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-3">Režim</p>
                <div class="grid grid-cols-2 gap-3">
                  <button type="button" data-mode="light" class="cfg-toggle-btn is-selected">Světlý režim</button>
                  <button type="button" data-mode="dark" class="cfg-toggle-btn">Tmavý režim</button>
                </div>
              </div>
            </div>

            <aside class="xl:sticky xl:top-28">
              <div id="livePreview" class="cfg-live-preview" data-template="modern" data-mode="light">
                <div class="cfg-preview-navbar">
                  <span class="cfg-preview-logo">Nexus</span>
                  <div class="cfg-preview-nav-items">
                    <span>Služby</span><span>Portfolio</span><span>Kontakt</span>
                  </div>
                </div>

                <div class="cfg-preview-hero">
                  <div>
                    <p class="cfg-preview-kicker">Web zaměřený na konverze</p>
                    <h3 class="cfg-preview-title">Profesionální web, který podporuje růst vašeho podnikání</h3>
                    <p class="cfg-preview-text">Živý náhled okamžitě reaguje na volbu šablony, fontu i barev.</p>
                    <button type="button" class="cfg-preview-cta">Spustit konfigurátor</button>
                  </div>
                  <div class="cfg-preview-media"></div>
                </div>

                <div class="cfg-preview-feature-row">
                  <div class="cfg-preview-feature">Rychlý</div>
                  <div class="cfg-preview-feature">Viditelnost na Googlu</div>
                  <div class="cfg-preview-feature">Škálovatelný</div>
                </div>

                <div class="cfg-preview-grid">
                  <div class="cfg-preview-card"></div>
                  <div class="cfg-preview-card"></div>
                  <div class="cfg-preview-card"></div>
                </div>

                <div class="cfg-preview-footer">© Vaše značka</div>
              </div>
            </aside>
          </div>
        </StepPanel>

        <StepPanel step={5} title="Detaily projektu" subtitle="Rozpočet, časový plán a připravenost pro realistické plánování.">
          <div class="space-y-5">
            <div>
              <p class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-3">Rozpočet</p>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <button type="button" data-detail="budget" data-value="5k-10k" class="cfg-toggle-btn is-selected">€5k – €10k</button>
                <button type="button" data-detail="budget" data-value="10k-20k" class="cfg-toggle-btn">€10k – €20k</button>
                <button type="button" data-detail="budget" data-value="20k+" class="cfg-toggle-btn">€20k+</button>
              </div>
            </div>

            <div>
              <p class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-3">Časový rámec</p>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <button type="button" data-detail="timeline" data-value="2–4 týdny" class="cfg-toggle-btn">2–4 týdny</button>
                <button type="button" data-detail="timeline" data-value="4–8 týdnů" class="cfg-toggle-btn is-selected">4–8 týdnů</button>
                <button type="button" data-detail="timeline" data-value="8+ týdnů" class="cfg-toggle-btn">8+ týdnů</button>
              </div>
            </div>

            <div>
              <p class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-3">Připravenost obsahu</p>
              <div class="grid grid-cols-2 gap-3">
                <button type="button" data-detail="contentReady" data-value="Ano" class="cfg-toggle-btn is-selected">Ano, obsah je připravený</button>
                <button type="button" data-detail="contentReady" data-value="Ne" class="cfg-toggle-btn">Ne, potřebuji pomoc s obsahem</button>
              </div>
            </div>

            <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 p-4 md:p-5 space-y-5">
              <div>
                <p class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">Podklady pro obsah (volitelné)</p>
                <p class="text-sm text-slate-600 dark:text-slate-300">Stávající konfigurace i obsah zůstávají zachovány. Tyto podklady slouží jen jako doplnění nebo přepis konkrétních sekcí.</p>
              </div>

              <div data-content-text-group>
                <p class="text-sm font-bold text-slate-800 dark:text-slate-100 mb-3">Obrázky podle sekcí</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  {assetSlots.map((slot) => (
                    <div class="cfg-upload-card" data-asset-slot-card={slot.id} data-related-pages={slot.relatedPages.join(',')}>
                      <label for={`asset-upload-${slot.id}`} class="text-sm font-bold text-slate-700 dark:text-slate-200">{slot.label}</label>
                      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 mb-2">{slot.hint}</p>
                      <input
                        id={`asset-upload-${slot.id}`}
                        data-image-upload={slot.id}
                        name={`assetUpload-${slot.id}`}
                        type="file"
                        multiple
                        accept="image/*"
                        class="w-full text-sm rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-2 file:mr-3 file:rounded-lg file:border-0 file:bg-primary/15 file:px-3 file:py-1.5 file:text-xs file:font-bold file:text-primary"
                      />
                      <p id={`asset-upload-list-${slot.id}`} data-image-upload-list={slot.id} class="mt-2 text-xs text-slate-500 dark:text-slate-400">Žádné soubory.</p>
                    </div>
                  ))}
                </div>
              </div>

              <p id="contentAssistHint" class="hidden text-xs text-slate-500 dark:text-slate-400">Pomůžeme vám s obsahem.</p>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4" data-content-text-group>
                <div class="space-y-2 md:col-span-2">
                  <label for="copyFilesInput" class="text-sm font-bold text-slate-700 dark:text-slate-300">Copywriting soubory</label>
                  <input
                    id="copyFilesInput"
                    data-copy-files
                    name="copyFiles"
                    type="file"
                    multiple
                    accept=".txt,.md,.doc,.docx,.pdf"
                    class="w-full text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-4 py-3 file:mr-3 file:rounded-lg file:border-0 file:bg-primary/15 file:px-3 file:py-1.5 file:text-xs file:font-bold file:text-primary"
                  />
                  <p id="copyFilesList" class="text-xs text-slate-500 dark:text-slate-400">Žádné soubory.</p>
                </div>

                <div class="space-y-2 md:col-span-2">
                  <label for="contentBrief" class="text-sm font-bold text-slate-700 dark:text-slate-300">Shrnutí obsahu</label>
                  <textarea id="contentBrief" data-content-brief class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-4 py-3 outline-none focus:border-primary resize-y" rows="3" placeholder="Např. klíčové sdělení, tone of voice, hlavní argumenty značky"></textarea>
                </div>
              </div>

              <div data-content-text-group>
                <p class="text-sm font-bold text-slate-800 dark:text-slate-100 mb-3">Texty podle sekcí</p>
                <p id="contentSectionsEmpty" class="hidden text-xs text-slate-500 dark:text-slate-400 mb-3">Vyberte stránky v kroku „Obsah webu“, aby se zobrazila odpovídající pole pro texty.</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  {contentSections.map((section) => (
                    <div class="cfg-upload-card" data-content-section-card={section.id}>
                      <div class="flex items-center justify-between gap-3 mb-2">
                        <p class="text-sm font-bold text-slate-700 dark:text-slate-200">{section.label}</p>
                        <select data-content-mode={section.id} class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-2 py-1 text-xs font-semibold text-slate-700 dark:text-slate-300 focus:border-primary outline-none">
                          <option value="keep">Ponechat stávající</option>
                          <option value="replace">Nahradit text</option>
