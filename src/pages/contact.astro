---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionRibbonBackground from '../components/SectionRibbonBackground.astro';
---

<Layout title="Kontakt | NexusDigital">
  <Header />
  <main class="relative overflow-hidden pt-28 pb-20 bg-background-light dark:bg-background-dark min-h-screen">
    <SectionRibbonBackground variant="hero" />

    <section class="relative z-10 max-w-5xl mx-auto px-6">
      <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800/80 bg-white/75 dark:bg-slate-900/65 backdrop-blur-[1px] p-6 md:p-8">
        <div class="max-w-3xl">
          <span class="inline-flex items-center gap-2 bg-primary/10 border border-primary/20 rounded-full px-4 py-1.5 mb-6 text-xs font-bold uppercase tracking-wider text-primary">
            Kontakt
          </span>
          <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-5 text-slate-900 dark:text-white">Pojďme probrat váš webový projekt</h1>
          <p class="text-slate-600 dark:text-slate-300 text-lg leading-relaxed">
            Napište nám základní informace a do 24 hodin se vám ozveme s návrhem dalšího postupu.
          </p>
        </div>
      </div>

      <div class="mt-10 grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
        <div class="lg:col-span-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 md:p-8">
          <h2 class="text-2xl font-black mb-2 text-slate-900 dark:text-white">Kontaktní formulář</h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 mb-6">Stačí stručně popsat cíl projektu. O zbytek se postaráme v navazujícím callu.</p>

          <form id="contactForm" action="/thank-you" method="get" class="space-y-5" novalidate>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label for="contact-name" class="text-sm font-bold text-slate-700 dark:text-slate-300">Jméno</label>
                <input id="contact-name" required class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 outline-none focus:border-primary" type="text" placeholder="Vaše jméno" />
              </div>
              <div class="space-y-2">
                <label for="contact-email" class="text-sm font-bold text-slate-700 dark:text-slate-300">E-mail</label>
                <input id="contact-email" required class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 outline-none focus:border-primary" type="email" placeholder="vas@email.cz" />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label for="contact-company" class="text-sm font-bold text-slate-700 dark:text-slate-300">Firma / projekt</label>
                <input id="contact-company" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 outline-none focus:border-primary" type="text" placeholder="Název projektu" />
              </div>
              <div class="space-y-2">
                <label for="contact-budget" class="text-sm font-bold text-slate-700 dark:text-slate-300">Rozpočet (volitelné)</label>
                <input id="contact-budget" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 outline-none focus:border-primary" type="text" placeholder="např. 60–120k Kč" />
              </div>
            </div>

            <div class="space-y-2">
              <label for="contact-message" class="text-sm font-bold text-slate-700 dark:text-slate-300">Co potřebujete?</label>
              <textarea id="contact-message" class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-4 py-3 outline-none focus:border-primary resize-y" rows="6" placeholder="Popište stručně cíl webu, rozsah a termín."></textarea>
            </div>

            <div class="flex flex-wrap gap-3 pt-1">
              <button id="contactSubmitBtn" type="submit" class="bg-primary text-white font-bold px-7 py-3 rounded-xl hover:bg-primary/90 transition-all disabled:opacity-70 disabled:cursor-not-allowed">
                Odeslat poptávku
              </button>
              <a href="/configurator" class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white font-bold px-7 py-3 rounded-xl hover:border-primary transition-all">
                Spustit konfigurátor
              </a>
            </div>

            <p id="contactFormStatus" class="hidden text-sm font-semibold" role="status" aria-live="polite"></p>
          </form>
        </div>

        <aside class="space-y-4 md:space-y-5">
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6">
            <h3 class="font-black text-lg mb-3 text-slate-900 dark:text-white">Přímý kontakt</h3>
            <div class="space-y-3 text-sm">
              <p class="text-slate-600 dark:text-slate-400"><span class="font-bold text-slate-900 dark:text-white">E-mail:</span> hello@nexusdigital.cz</p>
              <p class="text-slate-600 dark:text-slate-400"><span class="font-bold text-slate-900 dark:text-white">Telefon:</span> +420 777 000 000</p>
              <p class="text-slate-600 dark:text-slate-400"><span class="font-bold text-slate-900 dark:text-white">Odezva:</span> do 24 hodin v pracovní dny</p>
            </div>

            <a href="/configurator" class="inline-flex items-center gap-2 mt-5 text-primary font-bold text-sm hover:gap-3 transition-all">
              Nebo otevřít konfigurátor
              <span class="material-symbols-outlined text-base">north_east</span>
            </a>
          </div>
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  // @ts-nocheck
  const contactForm = document.getElementById('contactForm');
  const contactSubmitBtn = document.getElementById('contactSubmitBtn');
  const contactFormStatus = document.getElementById('contactFormStatus');

  if (contactForm instanceof HTMLFormElement) {
    contactForm.addEventListener('submit', (event) => {
      event.preventDefault();

      if (!contactForm.checkValidity()) {
        contactForm.reportValidity();
        if (contactFormStatus instanceof HTMLElement) {
          contactFormStatus.classList.remove('hidden', 'text-emerald-600');
          contactFormStatus.classList.add('text-rose-600');
          contactFormStatus.textContent = 'Formulář není kompletní. Prosím doplňte povinná pole.';
        }
        return;
      }

      if (contactFormStatus instanceof HTMLElement) {
        contactFormStatus.classList.remove('hidden', 'text-rose-600');
        contactFormStatus.classList.add('text-slate-600');
        contactFormStatus.textContent = 'Odesíláme poptávku…';
      }

      if (contactSubmitBtn instanceof HTMLButtonElement) {
        contactSubmitBtn.disabled = true;
      }

      window.setTimeout(() => {
        if (contactFormStatus instanceof HTMLElement) {
          contactFormStatus.classList.remove('text-slate-600', 'text-rose-600');
          contactFormStatus.classList.add('text-emerald-600');
          contactFormStatus.textContent = 'Děkujeme, poptávka byla odeslána.';
        }

        window.setTimeout(() => {
          window.location.href = '/thank-you?source=contact';
        }, 450);
      }, 500);
    });
  }
</script>
