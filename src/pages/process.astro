---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CardGrid from '../components/CardGrid.astro';
import SectionRibbonBackground from '../components/SectionRibbonBackground.astro';

const processSteps = [
  {
    icon: 'chat_bubble',
    title: '1. Dotaz / Brief',
    text: 'Discovery phase. We dive deep into your goals, audience, and project vision to build a solid strategic foundation.'
  },
  {
    icon: 'biotech',
    title: '2. Analýza & Zadání',
    text: 'Technical blueprint. We outline the architecture, features, and specifications required for a high-performance solution.'
  },
  {
    icon: 'palette',
    title: '3. Design Phase',
    text: 'Visual storytelling. Crafting stunning UI/UX designs that balance aesthetics with conversion-focused functionality.'
  },
  {
    icon: 'terminal',
    title: '4. Vývoj (Dev)',
    text: 'Code execution. Our developers build robust, scalable systems using cutting-edge tech stacks and agile methodologies.'
  },
  {
    icon: 'rocket_launch',
    title: '5. Spuštění',
    text: 'Blast off! Final testing, deployment, and team training to ensure you are fully equipped for your new digital era.'
  },
  {
    icon: 'support_agent',
    title: '6. Podpora',
    text: 'Constant growth. Long-term technical support and iterative improvements to keep you ahead of the competition.'
  }
];

const processGroups = [
  {
    id: 'strategy',
    title: 'Dotaz a zadání',
    description: 'Brief a analýza tvoří základní rámec projektu, cílů a technického směru.',
    items: processSteps.slice(0, 2)
  },
  {
    id: 'execution',
    title: 'Design a vývoj',
    description: 'Vizuální koncept převádíme do funkční, rychlé a škálovatelné realizace.',
    items: processSteps.slice(2, 4)
  },
  {
    id: 'launch-growth',
    title: 'Spuštění a podpora',
    description: 'Po launchi navazuje stabilní podpora, iterace a další růst projektu.',
    items: processSteps.slice(4)
  }
];
---

<Layout title="Process | NexusDigital">
  <Header />
  <main class="relative overflow-hidden pt-28 pb-20 bg-background-light dark:bg-background-dark min-h-screen">
    <SectionRibbonBackground variant="expertise" />

    <section class="relative z-10 max-w-5xl mx-auto px-6">
      <div class="rounded-2xl border border-slate-200/75 dark:border-slate-800/80 bg-white/70 dark:bg-slate-900/60 p-6 md:p-8 backdrop-blur-[1px]">
        <SectionHeader
          kicker="Process"
          title="Jak probíhá spolupráce"
          description="Transparentní postup od prvního zadání po spuštění a další optimalizaci."
        />

        <nav class="mt-8" aria-label="Fáze procesu">
          <div class="flex flex-wrap gap-2 md:gap-3">
            {processGroups.map((group) => (
              <a
                href={`#${group.id}`}
                class="inline-flex items-center rounded-full border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-900/75 px-4 py-2 text-sm font-semibold text-slate-700 dark:text-slate-200 hover:border-primary/40 hover:text-primary transition-colors"
              >
                {group.title}
              </a>
            ))}
          </div>
        </nav>
      </div>

      <div class="mt-12 space-y-12 md:space-y-14">
        {processGroups.map((group) => (
          <section id={group.id} class="scroll-mt-32 rounded-2xl border border-slate-200/80 dark:border-slate-800/80 bg-white/75 dark:bg-slate-900/65 backdrop-blur-[1px] p-6 md:p-8">
            <div class="mb-6">
              <h2 class="text-xl md:text-2xl font-black text-slate-900 dark:text-white">{group.title}</h2>
            </div>
            <div class="mb-6">
              <p class="text-sm md:text-base text-slate-600 dark:text-slate-300">{group.description}</p>
            </div>
            <CardGrid items={group.items} columns={2} />
          </section>
        ))}
      </div>

    </section>
  </main>
  <Footer />
</Layout>
