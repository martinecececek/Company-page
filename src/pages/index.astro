---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PricingSection from '../components/PricingSection.astro';
import RoadmapSection from '../components/RoadmapSection.astro';
import TrustedBrands from '../components/TrustedBrands.astro';
import ServicesSection from '../components/ServicesSection.astro';
import SuccessStories from '../components/SuccessStories.astro';
import WhyUs from '../components/WhyUs.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Digitální agentura | Tvoříme weby, které fungují"
  description="Nabízíme weby na míru pro reálný růst. Rychlé weby a online řešení. Více poptávek a lepší výkon vaší společnosti."
>
  <Header />
  <main class="pt-20 home-60-30-10">
    <Hero />
    <PricingSection />
    <RoadmapSection />
    <TrustedBrands />
    <ServicesSection />
    <SuccessStories />
    <WhyUs />
  </main>
  <Footer />
</Layout>
