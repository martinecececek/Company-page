---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SectionRibbonBackground from '../components/SectionRibbonBackground.astro';
import rlcDragonsPageView from '../assets/image/rlcdragons-page-view.png';

const cases = [
  {
    title: 'RLC Dragons Krupka',
    category: 'Web sportovního klubu',
    description: 'Náborově orientovaná homepage pro mládež i dospělé s jasnou strukturou obsahu a kontaktním flow.',
    result: 'Více příchozích poptávek během prvních týdnů',
    focus: ['Hierarchie obsahu', 'CTA zaměřené na poptávku', 'Přehlednost na mobilu'],
    image: rlcDragonsPageView.src
  },
  {
    title: 'Work-in-Time.cz',
    category: 'Web na získávání poptávek',
    description: 'Moderní prezentace náborové platformy s jasně oddělenou nabídkou pro kandidáty i zaměstnavatele.',
    result: 'Vyšší kvalita poptávek a plynulejší onboarding',
    focus: ['Segmentovaná komunikace', 'Rychlejší onboarding', 'Jasná nabídka služeb'],
    image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuA4loldbXfTaS7UTPXCZSsQ-N07_ORkUF4zSIxbJO6VkSBReJ1sKj9bB9ZyUYc4prijPFWknX07JF6T-VtTTCZq4nyrDZnnscBIq5WFGhbwSwaHxdxWzrOFF1Wxm9YgORHThkGlfiAA7Y-DSyDxJCEwMbHlKqLU3b56Lw70defuz7PNv-GtC0ra594LpLDZW1RJ_hMCus3hJ_cnAfcatucoPMYOMMzqccAuM2sdcKTEf-bLeBaVZ9DXRTJ-0VyF1ggIFPQCxRZzoaHl'
  },
  {
    title: 'Studio Brand Launch',
    category: 'Firemní web',
    description: 'Webová architektura postavená na značce se zaměřením na důvěru a konverzní výkon.',
    result: 'Rychlejší rezervace obchodních callů z webu',
    focus: ['Důvěryhodnost značky', 'Konverzní UX', 'Výkonnostní základ'],
    image: 'https://lh3.googleusercontent.com/aida-public/AB6AXuCYSLsaHd3svCQ3Sz0lqjt1ar4r8hs72BxPiKinJsLkVAXZMO1aYcbTb0EteKcOC4_yFUARuJvq-JCW1RXeIE9piORcZopz3PACWC03BAUB4Zyl7B7OcY3pHWpuWXKCz5Tuij9kPXvQdW5kg9IQt1_gFj_xuzuuf9PLHYOWANUoAtnH8Li6JhXlPvq5Y9pijVrLIDFWY9gOmQWaH0g8KLiI5qRyKESZnWaQXpBZ20_HyZ1TD7Acv6T6G-asgAWL0_HXmDkmTghhS0jm'
  }
];
---

<Layout title="Portfolio | NexusDigital">
  <Header />
  <main class="relative overflow-hidden pt-28 pb-20 bg-background-light dark:bg-background-dark min-h-screen">
    <SectionRibbonBackground variant="why" />

    <section class="relative z-10 max-w-5xl mx-auto px-6">
      <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800/80 bg-white/75 dark:bg-slate-900/65 backdrop-blur-[1px] p-6 md:p-8">
        <div class="max-w-3xl">
          <SectionHeader
            kicker="Portfolio"
            title="Ukázky realizovaných webů"
            description="Každý projekt je postavený na konkrétním obchodním cíli. Níže uvidíte zaměření a dopad jednotlivých realizací."
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 -mt-4">
          <div class="rounded-xl border border-slate-200/80 dark:border-slate-700/80 bg-white/80 dark:bg-slate-900/70 p-4">
            <p class="text-xs font-black uppercase tracking-wide text-slate-500 dark:text-slate-400">Realizace</p>
            <p class="mt-1 text-xl font-black text-slate-900 dark:text-white">3 případové studie</p>
          </div>
          <div class="rounded-xl border border-slate-200/80 dark:border-slate-700/80 bg-white/80 dark:bg-slate-900/70 p-4">
            <p class="text-xs font-black uppercase tracking-wide text-slate-500 dark:text-slate-400">Zaměření</p>
            <p class="mt-1 text-xl font-black text-slate-900 dark:text-white">Poptávky a konverze</p>
          </div>
          <div class="rounded-xl border border-slate-200/80 dark:border-slate-700/80 bg-white/80 dark:bg-slate-900/70 p-4">
            <p class="text-xs font-black uppercase tracking-wide text-slate-500 dark:text-slate-400">Postup</p>
            <p class="mt-1 text-xl font-black text-slate-900 dark:text-white">Strategie → spuštění</p>
          </div>
        </div>
      </div>

      <div class="mt-10 space-y-8 md:space-y-10">
        {cases.map((item, index) => (
          <article class="block rounded-2xl overflow-hidden border border-slate-200/80 dark:border-slate-800/80 bg-white/75 dark:bg-slate-900/65 backdrop-blur-[1px] p-5 md:p-7">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 items-center">
              <div class={index % 2 === 0 ? 'order-2 lg:order-1' : 'order-2 lg:order-2'}>
                <div class="flex flex-wrap items-center gap-2 mb-4">
                  <span class="inline-flex items-center bg-primary/10 text-primary text-xs font-bold px-3 py-1 rounded-full">
                    {item.category}
                  </span>
                  <span class="inline-flex items-center rounded-full border border-slate-200 dark:border-slate-700 px-3 py-1 text-xs font-bold text-slate-500 dark:text-slate-400">
                    Případ {index + 1}
                  </span>
                </div>

                <h2 class="text-2xl md:text-3xl font-black tracking-tight mb-4 text-slate-900 dark:text-white">{item.title}</h2>
                <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-5">{item.description}</p>

                <div class="rounded-xl border border-primary/20 bg-primary/5 px-4 py-3 mb-5">
                  <p class="text-xs font-black uppercase tracking-wide text-primary mb-1">Výsledek</p>
                  <p class="text-slate-900 dark:text-white font-bold">{item.result}</p>
                </div>

                <div class="mb-6">
                  <p class="text-xs font-black uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-2">Na co jsme se zaměřili</p>
                  <div class="flex flex-wrap gap-2">
                    {item.focus.map((focusItem) => (
                      <span class="inline-flex items-center rounded-full bg-slate-100 dark:bg-slate-800 px-3 py-1 text-xs font-bold text-slate-600 dark:text-slate-300">
                        {focusItem}
                      </span>
                    ))}
                  </div>
                </div>

                <a href="/configurator?preset=similar-case" class="inline-flex items-center justify-center bg-primary text-white font-bold px-5 py-2.5 rounded-xl hover:bg-primary/90 transition-all">
                  Chci podobné řešení
                </a>
              </div>

              <div class={index % 2 === 0 ? 'order-1 lg:order-2' : 'order-1 lg:order-1'}>
                <div class="rounded-xl overflow-hidden border border-slate-300 dark:border-slate-700 bg-white">
                  <img
                    src={item.image}
                    alt={`${item.title} page view`}
                    loading="lazy"
                    class="w-full h-[220px] md:h-[320px] object-cover object-top"
                  />
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>

    </section>
  </main>
  <Footer />
</Layout>
